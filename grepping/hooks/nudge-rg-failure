#!/usr/bin/env python3
"""PostToolUse hook: diagnose rg failures with an inline corrected command."""

from __future__ import annotations

import json
import re
import sys

from rg_hooklib import (
    guard_issues,
    has_filters,
    iter_rg_invocations,
    scan_rg,
)

_EXIT_PREFIX = re.compile(r"^\s*Exit code\s+(\d+)\s*\n?", re.IGNORECASE)
_HARD_ERROR = re.compile(
    r"unrecognized flag|regex parse error|missing value for flag|unknown encoding|"
    r"unrecognized file type|look-around.*not supported|backreferences? .*not supported|"
    r"error:.*(?:invalid|unexpected)",
    re.IGNORECASE,
)


def parse_tool_response(response: object) -> tuple[str, str, int]:
    """Normalize both Claude Code's dict and `Exit code N` string response shapes."""
    if isinstance(response, dict):
        stderr = str(response.get("stderr", "") or "")
        stdout = str(response.get("stdout", "") or "")
        try:
            exit_code = int(response.get("exit_code", 0) or 0)
        except (TypeError, ValueError):
            exit_code = 0
        return stderr, stdout, exit_code
    if isinstance(response, str):
        match = _EXIT_PREFIX.match(response)
        if match:
            return response[match.end() :], "", int(match.group(1))
        return "", response, 0
    return "", "", 0


def _hard_error_fix(text: str) -> str:
    lowered = text.lower()
    if "look-around" in lowered or "backreference" in lowered or "\\k" in text:
        return "Add `-P` for lookaround, `\\K`, or backreferences."
    if "repetition quantifier" in lowered or "regex parse error" in lowered:
        return "Use `-F` for literal code text, or escape regex metacharacters such as `{`."
    if "unknown encoding" in lowered:
        return "Drop grep's `-E`; rg is ERE-like by default."
    if "unrecognized file type" in lowered:
        return "Use a known `-t` type, `rg --type-list`, or a `-g '*.ext'` glob."
    if "--include" in text or "--exclude" in text:
        return "Translate grep file filters to `-g` (or a known `-t` type)."
    if "-r" in text and "missing value" in lowered:
        return "Drop `-r`; rg is recursive by default and `-r` means `--replace`."
    return "Apply the reported flag/regex correction before retrying."


def build_nudge(command: str, stderr: str, stdout: str, exit_code: int) -> str | None:
    invocations = list(iter_rg_invocations(command))
    if not invocations:
        return None

    # This catches success-shaped -rn/-rl corruption too, including non-empty output.
    issues = [issue for invocation in invocations for issue in guard_issues(invocation)]
    if issues:
        messages = list(dict.fromkeys(issue.message for issue in issues))
        return "grepping: rg produced or attempted a deterministic bad invocation. " + " ".join(messages)

    combined = "\n".join(part for part in (stderr, stdout) if part)
    if _HARD_ERROR.search(combined) or exit_code not in (0, 1):
        return f"grepping: rg exited with an error. {_hard_error_fix(combined)}"

    if exit_code == 1:
        if any(has_filters(invocation) for invocation in invocations):
            return (
                "grepping: rg found no matches while `-t`/`-g` filters were active. "
                "Check the filter, then try `--no-ignore --hidden` (or `--debug`) before "
                "concluding the text is absent."
            )
        if any(
            "\\n" in pattern.value
            for invocation in invocations
            for pattern in scan_rg(invocation).patterns
        ):
            return "grepping: a `\\n` pattern needs `-U` because rg multiline mode is off by default."
    return None


def main() -> None:
    try:
        raw = sys.stdin.read()
        data = json.loads(raw) if raw.strip() else {}
    except (json.JSONDecodeError, OSError, AttributeError):
        return
    if data.get("tool_name") != "Bash":
        return
    tool_input = data.get("tool_input") or {}
    command = tool_input.get("command", "") if isinstance(tool_input, dict) else ""
    if not command:
        return
    stderr, stdout, exit_code = parse_tool_response(data.get("tool_response"))
    nudge = build_nudge(command, stderr, stdout, exit_code)
    if nudge is None:
        return
    result = {
        "hookSpecificOutput": {
            "hookEventName": "PostToolUse",
            "additionalContext": nudge,
        }
    }
    json.dump(result, sys.stdout)


if __name__ == "__main__":
    main()
