#!/usr/bin/env python3
"""PreToolUse guard for deterministic rg failures plus precise search nudges."""

from __future__ import annotations

import hashlib
import json
import os
import re
import shlex
import sys
from pathlib import Path

from rg_hooklib import (
    bypassed,
    advisory_warnings,
    guard_issues,
    iter_rg_invocations,
    log_decision,
    remote_rg_stages,
    scan_rg,
    shell_stages,
)

GREP_TOOLS = {"grep", "egrep", "fgrep", "ugrep", "ug"}
RG_SG_TOOLS = {"rg", "sg", "ast-grep"}
SEARCH_TOOLS = GREP_TOOLS | RG_SG_TOOLS
_SYMBOL_RE = re.compile(r"\b(?:func|def|class|struct|interface|trait|impl|fn|function)\b")


def leading_search(command: str) -> tuple[str, str] | None:
    """Find a leading search command, excluding grep used only as a pipe filter."""
    for stage in shell_stages(command):
        if stage.separator == "|":
            continue
        try:
            tokens = shlex.split(stage.text, comments=False, posix=True)
        except ValueError:
            continue
        while tokens and re.match(r"^[A-Za-z_]\w*=", tokens[0]):
            tokens.pop(0)
        if not tokens:
            continue
        tool = os.path.basename(tokens[0])
        if tool in SEARCH_TOOLS:
            return tool, stage.text
    return None


def _pattern_arguments(tool: str, stage: str) -> list[str]:
    try:
        tokens = shlex.split(stage, comments=False, posix=True)
    except ValueError:
        return []
    while tokens and re.match(r"^[A-Za-z_]\w*=", tokens[0]):
        tokens.pop(0)
    if not tokens:
        return []
    if tool == "rg":
        invocation = next(iter_rg_invocations(stage), None)
        return [pattern.value for pattern in scan_rg(invocation).patterns] if invocation else []
    if tool in {"sg", "ast-grep"}:
        for index, token in enumerate(tokens[1:], start=1):
            if token in {"-p", "--pattern"} and index + 1 < len(tokens):
                return [tokens[index + 1]]
            if token.startswith("--pattern="):
                return [token.split("=", 1)[1]]
        return []

    # grep family: -e PATTERN is explicit; otherwise first non-option is PATTERN.
    patterns: list[str] = []
    index = 1
    while index < len(tokens):
        token = tokens[index]
        if token in {"-e", "--regexp"} and index + 1 < len(tokens):
            patterns.append(tokens[index + 1])
            index += 2
            continue
        if token.startswith("--regexp="):
            patterns.append(token.split("=", 1)[1])
        elif token == "--":
            if index + 1 < len(tokens):
                patterns.append(tokens[index + 1])
            break
        elif not token.startswith("-"):
            patterns.append(token)
            break
        index += 1
    return patterns


def _find_repo_root(cwd: str) -> str:
    directory = cwd
    for _ in range(50):
        if not directory:
            break
        if any(os.path.exists(os.path.join(directory, marker)) for marker in (".mcp.json", ".git", ".jj")):
            return directory
        parent = os.path.dirname(directory)
        if parent == directory:
            break
        directory = parent
    return cwd


def _candidate_configs(repo_root: str) -> list[str]:
    home = os.path.expanduser("~")
    paths = []
    if repo_root:
        paths.extend(
            [
                os.path.join(repo_root, ".mcp.json"),
                os.path.join(repo_root, ".claude", "settings.json"),
                os.path.join(repo_root, ".claude", "settings.local.json"),
            ]
        )
    paths.extend([os.path.join(home, ".claude.json"), os.path.join(home, ".claude", "settings.json")])
    return paths


def _config_signature(paths: list[str]) -> str:
    parts = []
    for path in paths:
        try:
            stat = os.stat(path)
        except OSError:
            continue
        parts.append(f"{path}:{stat.st_mtime_ns}:{stat.st_size}")
    return "|".join(parts)


def _has_probe_server(value: object) -> bool:
    if isinstance(value, dict):
        for key in ("mcpServers", "mcp_servers"):
            servers = value.get(key)
            if isinstance(servers, dict) and "probe" in servers:
                return True
        return any(_has_probe_server(child) for child in value.values())
    if isinstance(value, list):
        return any(_has_probe_server(child) for child in value)
    return False


def _scan_for_probe(paths: list[str]) -> bool:
    for path in paths:
        try:
            raw = Path(path).read_text(encoding="utf-8")
        except OSError:
            continue
        if '"probe"' not in raw:
            continue
        try:
            value = json.loads(raw)
        except json.JSONDecodeError:
            return True
        if _has_probe_server(value):
            return True
    return False


def _cache_path(repo_root: str) -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    key = hashlib.sha1(repo_root.encode()).hexdigest()[:16]
    return Path(base) / "grepping" / f"probe-{key}.json"


def probe_available(repo_root: str) -> bool:
    paths = _candidate_configs(repo_root)
    signature = _config_signature(paths)
    cache = _cache_path(repo_root)
    try:
        cached = json.loads(cache.read_text(encoding="utf-8"))
        if cached.get("sig") == signature:
            return bool(cached.get("probe"))
    except (OSError, json.JSONDecodeError):
        pass
    result = _scan_for_probe(paths)
    try:
        cache.parent.mkdir(parents=True, exist_ok=True)
        temporary = cache.with_name(f"{cache.name}.{os.getpid()}.tmp")
        temporary.write_text(json.dumps({"probe": result, "sig": signature}), encoding="utf-8")
        os.replace(temporary, cache)
    except OSError:
        pass
    return result


def _probe_nudge_allowed(session_id: str) -> bool:
    """Allow at most one probe advisory per Claude session."""
    if not session_id:
        return True
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    key = hashlib.sha1(session_id.encode()).hexdigest()[:20]
    sentinel = Path(base) / "grepping" / f"probe-nudge-{key}"
    try:
        sentinel.parent.mkdir(parents=True, exist_ok=True)
        descriptor = os.open(sentinel, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(descriptor)
    except FileExistsError:
        return False
    except OSError:
        return True
    return True


def _advisory_message(tool: str, *, probe: bool) -> str:
    if probe:
        return (
            f"grepping: `{tool}` pattern looks like a symbol search. Prefer "
            "`mcp__probe__search_code` / `extract_code` for the enclosing definition; "
            "use rg for raw text and ast-grep for syntax shapes."
        )
    return (
        f"grepping: `{tool}` invoked. Prefer rg for recursive text search and ast-grep "
        "for syntax-aware matches; use grep-family tools only for a specific feature or fallback."
    )


def main() -> None:
    try:
        raw = sys.stdin.read()
        data = json.loads(raw) if raw.strip() else {}
    except (json.JSONDecodeError, OSError, AttributeError):
        return
    if data.get("tool_name") != "Bash":
        return
    tool_input = data.get("tool_input") or {}
    command = tool_input.get("command", "") if isinstance(tool_input, dict) else ""
    if not command:
        return

    invocations = list(iter_rg_invocations(command))
    if bypassed(command):
        for invocation in invocations:
            log_decision(data, decision="bypass", rules=["RG_GUARD_OK"], stage=invocation.stage.text)
        return

    denied = []
    warnings = []
    for invocation in invocations:
        issues = guard_issues(invocation)
        invocation_warnings = advisory_warnings(invocation)
        decision = "deny" if issues else "warn" if invocation_warnings else "allow"
        log_decision(
            data,
            decision=decision,
            rules=[issue.rule for issue in issues],
            stage=invocation.stage.text,
        )
        denied.extend(issues)
        warnings.extend(invocation_warnings)

    if denied:
        unique_messages = list(dict.fromkeys(issue.message for issue in denied))
        result = {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": "rg-guard denied a deterministic failure. "
                + " ".join(unique_messages)
                + " To bypass an intentional use, prefix the command with `RG_GUARD_OK=1`.",
            }
        }
        json.dump(result, sys.stdout)
        return

    for remote in remote_rg_stages(command):
        warnings.append(
            "A remote host may not have rg. Prefer `ssh host 'producer' | rg PATTERN` so "
            f"filtering runs locally (remote stage: `{remote}`)."
        )

    search = leading_search(command)
    if search:
        tool, stage = search
        patterns = _pattern_arguments(tool, stage)
        symbol = any(_SYMBOL_RE.search(pattern) for pattern in patterns)
        use_probe = symbol and probe_available(_find_repo_root(str(data.get("cwd", "") or "")))
        if use_probe and _probe_nudge_allowed(str(data.get("session_id", "") or "")):
            warnings.append(_advisory_message(tool, probe=True))
        elif tool in GREP_TOOLS:
            warnings.append(_advisory_message(tool, probe=False))

    if not warnings:
        return
    result = {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "additionalContext": " ".join(dict.fromkeys(warnings)),
        }
    }
    json.dump(result, sys.stdout)


if __name__ == "__main__":
    main()
